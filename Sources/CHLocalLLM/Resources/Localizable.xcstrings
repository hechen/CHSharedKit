    "On-device, free, private. No data leaves your device.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device, free, private. No data leaves your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät, kostenlos und privat. Keine Daten verlassen dein Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’appareil, gratuit et privé. Aucune donnée ne quitte votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul dispositivo, gratuita e privata. Nessun dato lascia il dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No dispositivo, grátis e privado. Nenhum dado sai do dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Local, gratis y privado. Ningún dato sale de tu dispositivo."
          }
