    "%@ is provided under this license. Review its terms before downloading.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is provided under this license. Review its terms before downloading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird unter dieser Lizenz bereitgestellt. Lies die Bedingungen vor dem Herunterladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est fourni sous cette licence. Consultez ses conditions avant de le télécharger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è fornito con questa licenza. Leggine i termini prima di scaricarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é fornecido sob esta licença. Leia os termos antes de baixar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ofrece bajo esta licencia. Revisa sus condiciones antes de descargarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 按此许可证提供。下载前请阅读条款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのライセンスで提供されます。ダウンロード前に条件を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이 라이선스로 제공됩니다. 다운로드 전에 약관을 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 依此授權條款提供。下載前請先閱讀條款。"
          }
        }
      }
    },
