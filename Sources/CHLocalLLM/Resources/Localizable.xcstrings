    "A newer version is available, but it cannot run in this app. %@": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version is available, but it cannot run in this app. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version ist verfügbar, aber sie kann in dieser App nicht ausgeführt werden. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version plus récente est disponible, mais elle ne peut pas fonctionner dans cette application. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una versione più recente, ma non può essere eseguita in questa app. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma versão mais recente, mas ela não pode ser executada neste app. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una versión nueva, pero no puede ejecutarse en esta app. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有新版本，但无法在此 App 中运行。%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがありますが、このアプリでは実行できません。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전이 있지만 이 앱에서 실행할 수 없습니다. %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有新版本，但無法在此 App 中執行。%@"
          }
        }
      }
    },
