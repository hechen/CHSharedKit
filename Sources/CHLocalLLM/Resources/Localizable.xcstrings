          "stringUnit": {
            "state": "translated",
            "value": "Closet kann jetzt Kleidungsstücke einordnen, Marken erkennen und Outfits vorschlagen – privat auf deinem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet peut désormais classer les vêtements, reconnaître les marques et suggérer des tenues en toute confidentialité sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet ora può classificare i capi, riconoscere i marchi e suggerire outfit in modo privato sul tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Closet agora pode categorizar peças, detectar marcas e sugerir looks com privacidade no seu dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet ahora clasifica prendas, detecta marcas y sugiere conjuntos de forma privada en tu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet 现可在你的设备上私密分类衣物、识别品牌并推荐穿搭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Closetはデバイス内で衣類の分類、ブランド認識、コーデ提案をプライベートに行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet이 이제 기기에서 비공개로 의류 분류, 브랜드 감지, 코디 추천을 수행합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet 現在可以在你的裝置上私密地分類單品、辨識品牌並建議穿搭。"
          }
        }
      }
    },
