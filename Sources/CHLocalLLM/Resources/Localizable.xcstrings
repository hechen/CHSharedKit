    "Insufficient memory — close other apps and try again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insufficient memory — close other apps and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend Arbeitsspeicher. Schließe andere Apps und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire insuffisante. Fermez les autres apps et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria insufficiente: chiudi le altre app e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória insuficiente. Feche outros apps e tente novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria insuficiente. Cierra otras apps e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存不足，请关闭其他 App 后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリが足りません。他のアプリを閉じて再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리가 부족합니다. 다른 앱을 닫고 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶體不足，請關閉其他 App 後再試一次。"
          }
        }
      }
    },
    "LiftCoach can now suggest workouts, detect plateaus, and write training summaries privately on your device. Your workout data never leaves this iPhone.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach can now suggest workouts, detect plateaus, and write training summaries privately on your device. Your workout data never leaves this iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach kann jetzt Trainingseinheiten vorschlagen, Plateaus erkennen und Trainingszusammenfassungen schreiben – privat auf deinem Gerät. Deine Trainingsdaten verlassen dieses iPhone nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach peut désormais suggérer des séances, détecter les stagnations et rédiger des bilans en toute confidentialité sur votre appareil. Vos données d’entraînement ne quittent jamais cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach ora può suggerire allenamenti, rilevare stalli e scrivere riepiloghi in modo privato sul tuo dispositivo. I dati dei tuoi allenamenti non lasciano mai questo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LiftCoach agora pode sugerir treinos, detectar estagnações e escrever resumos de treino com privacidade no seu dispositivo. Seus dados de treino nunca saem deste iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach ahora sugiere entrenamientos, detecta estancamientos y redacta resúmenes de forma privada en tu dispositivo. Tus datos nunca salen de este iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach 现可在设备上私密推荐训练、发现平台期并撰写训练总结。训练数据不会离开此 iPhone。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoachはデバイス内でワークアウト提案、停滞期の検出、トレーニングのまとめをプライベートに行えます。データはこのiPhoneの外へ出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach가 이제 기기에서 비공개로 운동 추천, 정체기 감지, 운동 요약을 제공합니다. 운동 데이터는 이 iPhone 밖으로 나가지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiftCoach 現在可以在你的裝置上私密地建議訓練內容、偵測停滯期並撰寫訓練摘要。你的訓練資料不會離開這支 iPhone。"
          }
        }
      }
    },
