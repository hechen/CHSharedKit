        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version ist verfügbar, benötigt aber mehr Speicher als dieses Gerät hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version plus récente est disponible, mais elle nécessite plus de mémoire que ce dispositif n’en possède."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una versione più recente, ma richiede più memoria di quella disponibile su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma versão mais recente, mas ela precisa de mais memória do que este dispositivo tem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una versión nueva, pero necesita más memoria de la que tiene este dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有新版本，但所需内存超过此设备的容量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがありますが、このデバイスより多くのメモリが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전이 있지만 이 기기의 메모리 용량보다 더 많은 메모리가 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有新版本，但所需記憶體超過此裝置的容量。"
          }
        }
      }
    },
