    "Each service uses your own API key and bills your account with that provider. Chat subscriptions such as ChatGPT Plus or Claude Pro do not include API usage.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each service uses your own API key and bills your account with that provider. Chat subscriptions such as ChatGPT Plus or Claude Pro do not include API usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Dienst verwendet deinen API-Schlüssel und rechnet die Nutzung über dein Konto bei diesem Anbieter ab. Chat-Abos wie ChatGPT Plus oder Claude Pro enthalten keine API-Nutzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque service utilise votre clé API et facture votre compte chez ce fournisseur. Les abonnements de chat comme ChatGPT Plus ou Claude Pro n’incluent pas l’utilisation des API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni servizio usa la tua chiave API e addebita i costi al tuo account presso il fornitore. Gli abbonamenti alle chat, come ChatGPT Plus o Claude Pro, non includono l’utilizzo delle API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serviço usa sua própria chave de API e cobra na sua conta do respectivo provedor. Assinaturas de chat, como ChatGPT Plus ou Claude Pro, não incluem o uso de API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servicio usa tu clave API y cobra a tu cuenta con ese proveedor. Suscripciones de chat como ChatGPT Plus o Claude Pro no incluyen uso de API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各服务使用你自己的 API 密钥，并向对应服务商账户计费。ChatGPT Plus 或 Claude Pro 等聊天订阅不包含 API 用量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サービスでは自分のAPIキーを使い、そのプロバイダのアカウントに課金されます。ChatGPT PlusやClaude Proなどのチャット契約にAPI利用は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 서비스는 자신의 API 키를 사용하며 해당 제공업체 계정에 요금을 청구합니다. ChatGPT Plus 또는 Claude Pro 같은 채팅 구독에는 API 사용량이 포함되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各項服務使用你自己的 API 金鑰，並向你在該供應商的帳號計費。ChatGPT Plus 或 Claude Pro 等聊天訂閱方案不包含 API 用量。"
          }
        }
      }
    },
