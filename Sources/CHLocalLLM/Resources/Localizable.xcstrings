    "Cloud providers use your own API key and bill your account with that provider. Chat subscriptions such as ChatGPT Plus or Claude Pro do not include API usage.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud providers use your own API key and bill your account with that provider. Chat subscriptions such as ChatGPT Plus or Claude Pro do not include API usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Anbieter verwenden deinen API-Schlüssel und rechnen die Nutzung über dein Konto bei ihnen ab. Chat-Abos wie ChatGPT Plus oder Claude Pro enthalten keine API-Nutzung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fournisseurs cloud utilisent votre clé API et facturent votre compte chez eux. Les abonnements de chat comme ChatGPT Plus ou Claude Pro n’incluent pas l’utilisation des API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fornitori cloud usano la tua chiave API e addebitano i costi al tuo account presso di loro. Gli abbonamenti alle chat, come ChatGPT Plus o Claude Pro, non includono l’utilizzo delle API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os provedores de nuvem usam sua própria chave de API e cobram na sua conta do respectivo provedor. Assinaturas de chat, como ChatGPT Plus ou Claude Pro, não incluem o uso de API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proveedores en la nube usan tu clave API y cobran a tu cuenta. Suscripciones de chat como ChatGPT Plus o Claude Pro no incluyen uso de API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端服务商使用你自己的 API 密钥，并向你的服务商账户计费。ChatGPT Plus 或 Claude Pro 等聊天订阅不包含 API 用量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドでは自分のAPIキーを使い、そのプロバイダのアカウントに課金されます。ChatGPT PlusやClaude Proなどのチャット契約にAPI利用は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 제공업체는 자신의 API 키를 사용하며 해당 계정에 요금을 청구합니다. ChatGPT Plus 또는 Claude Pro 같은 채팅 구독에는 API 사용량이 포함되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端供應商使用你自己的 API 金鑰，並向你在該供應商的帳號計費。ChatGPT Plus 或 Claude Pro 等聊天訂閱方案不包含 API 用量。"
          }
        }
      }
    },
    "Connect an OpenAI-compatible service that you operate or trust.": {
      "extractionState": "manual",
