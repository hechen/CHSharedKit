    "Refreshing checks availability. Model downloads start only when you choose them.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing checks availability. Model downloads start only when you choose them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Aktualisieren wird die Verfügbarkeit geprüft. Modelle werden erst heruntergeladen, wenn du sie auswählst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’actualisation vérifie la disponibilité. Les téléchargements ne commencent que lorsque vous choisissez un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento verifica la disponibilità. Il download dei modelli inizia solo quando li selezioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização verifica a disponibilidade. Os downloads de modelos só começam quando você os escolhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar comprueba la disponibilidad. Los modelos solo se descargan cuando los eliges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新仅检查可用性，只有选择模型后才会开始下载。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新は利用可能かどうかを確認します。選択した場合のみダウンロードを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로고침은 사용 가능 여부를 확인합니다. 모델을 선택해야 다운로드가 시작됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理只會檢查可用性，只有在你選擇模型後才會開始下載。"
          }
        }
      }
    },
