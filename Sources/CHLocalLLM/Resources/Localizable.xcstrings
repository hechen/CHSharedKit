    "Requires Wi-Fi or cellular. Download once; model persists on device.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Wi-Fi or cellular. Download once; model persists on device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert WLAN oder Mobilfunk. Einmal herunterladen, dann bleibt das Modell auf dem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite le Wi-Fi ou le réseau cellulaire. Téléchargez une seule fois : le modèle reste sur l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Wi-Fi o rete cellulare. Scaricalo una sola volta: il modello resta sul dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige Wi-Fi ou rede celular. Baixe uma vez; o modelo permanece no dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Wi-Fi o datos móviles. Descárgalo una vez y el modelo permanecerá en el dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Wi-Fi 或蜂窝网络。下载一次后，模型会保留在设备上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiかモバイル通信が必要です。一度ダウンロードするとモデルはデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 또는 셀룰러가 필요합니다. 한 번 다운로드하면 모델이 기기에 저장됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要 Wi-Fi 或行動網路。只需下載一次，模型會保留在裝置上。"
          }
        }
      }
    },
