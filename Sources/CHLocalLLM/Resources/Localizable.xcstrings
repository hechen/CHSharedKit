    "SpendWisely now categorizes transactions and generates insights privately. Your financial data never leaves this iPhone.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely now categorizes transactions and generates insights privately. Your financial data never leaves this iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely ordnet jetzt Transaktionen ein und erstellt Analysen – privat auf deinem Gerät. Deine Finanzdaten verlassen dieses iPhone nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely classe désormais les transactions et produit des analyses en toute confidentialité. Vos données financières ne quittent jamais cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely ora classifica le transazioni e genera approfondimenti in modo privato. I tuoi dati finanziari non lasciano mai questo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SpendWisely agora categoriza transações e gera análises com privacidade. Seus dados financeiros nunca saem deste iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely ahora clasifica transacciones y genera análisis de forma privada. Tus datos financieros nunca salen de este iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely 现可私密分类交易并生成洞察。财务数据不会离开此 iPhone。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWiselyは取引の分類と分析をプライベートに行えます。財務データはこのiPhoneから出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely가 이제 비공개로 거래를 분류하고 분석합니다. 금융 데이터는 이 iPhone 밖으로 나가지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SpendWisely 現在能私密地分類交易並產生洞察。你的財務資料不會離開這支 iPhone。"
          }
        }
      }
    },
