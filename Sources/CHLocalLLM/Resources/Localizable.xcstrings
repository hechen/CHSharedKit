            "state": "translated",
            "value": "Couldn’t refresh the model list. Your saved list and installed models are still available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellliste konnte nicht aktualisiert werden. Deine gespeicherte Liste und installierten Modelle sind weiterhin verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
