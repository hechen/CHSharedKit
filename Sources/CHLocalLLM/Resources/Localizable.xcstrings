    "No data received in the last 30 seconds. Tap Retry to resume — already-downloaded files are skipped.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data received in the last 30 seconds. Tap Retry to resume — already-downloaded files are skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 30 Sekunden wurden keine Daten empfangen. Tippe auf „Erneut versuchen“, um fortzufahren. Bereits heruntergeladene Dateien werden übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée reçue depuis 30 secondes. Touchez Réessayer pour reprendre. Les fichiers déjà téléchargés seront ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato ricevuto negli ultimi 30 secondi. Tocca Riprova per riprendere: i file già scaricati verranno saltati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dado recebido nos últimos 30 segundos. Toque em Tentar novamente para continuar. Os arquivos já baixados serão ignorados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han recibido datos en 30 segundos. Toca Reintentar para continuar; se omiten los archivos ya descargados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 30 秒未收到数据。点按“重试”继续，已下载文件会跳过。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去30秒間データを受信していません。「再試行」で再開し、ダウンロード済みファイルはスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 30초 동안 데이터를 받지 못했습니다. 다시 시도를 탭하면 이미 다운로드한 파일은 건너뛰고 계속합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 30 秒未收到任何資料。點一下「重試」以繼續，已下載的檔案會略過。"
          }
        }
      }
    },
    "No longer listed. You can let this download finish or cancel it.": {
      "extractionState": "manual",
