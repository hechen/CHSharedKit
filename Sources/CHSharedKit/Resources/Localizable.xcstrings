    "Your previously-selected model (%@) was retired. We switched you to %@.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your previously-selected model (%1$@) was retired. We switched you to %2$@."
