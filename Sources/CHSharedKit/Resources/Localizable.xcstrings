    "Each feature can use its own AI provider. Tap a feature to override the default.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each feature can use its own AI provider. Tap a feature to override the default."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Funktion kann einen eigenen KI-Anbieter nutzen. Tippe auf eine Funktion, um den Standardanbieter zu ersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fonction peut utiliser son propre fournisseur d’IA. Touchez une fonction pour remplacer le fournisseur par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni funzione può usare un proprio fornitore IA. Tocca una funzione per sostituire quello predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada recurso pode usar seu próprio provedor de IA. Toque em um recurso para substituir o padrão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada función puede usar su propio proveedor. Toca una función para cambiar el predeterminado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项功能可使用不同 AI 服务商。点按功能可覆盖默认设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能ごとにAIプロバイダを選べます。機能をタップして標準設定を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 기능에 별도 AI 제공업체를 사용할 수 있습니다. 기능을 탭하여 기본값을 변경하세요."
          }
        }
      }
    },
    "Embed `CHAIProviderPickerView(appIdentifier:)` from CHLocalLLM in this NavigationStack to switch the default provider.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embed `CHAIProviderPickerView(appIdentifier:)` from CHLocalLLM in this NavigationStack to switch the default provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bette `CHAIProviderPickerView(appIdentifier:)` aus CHLocalLLM in diesen NavigationStack ein, um den Standardanbieter zu wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intégrez `CHAIProviderPickerView(appIdentifier:)` de CHLocalLLM dans cette NavigationStack pour changer le fournisseur par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci `CHAIProviderPickerView(appIdentifier:)` di CHLocalLLM in questo NavigationStack per cambiare il fornitore predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorpore `CHAIProviderPickerView(appIdentifier:)` do CHLocalLLM nesta NavigationStack para trocar o provedor padrão."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta `CHAIProviderPickerView(appIdentifier:)` de CHLocalLLM en este NavigationStack para cambiar el proveedor predeterminado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 NavigationStack 中嵌入 CHLocalLLM 的 `CHAIProviderPickerView(appIdentifier:)`，即可切换默认服务商。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このNavigationStackにCHLocalLLMの`CHAIProviderPickerView(appIdentifier:)`を埋め込むと、標準プロバイダを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 NavigationStack에 CHLocalLLM의 `CHAIProviderPickerView(appIdentifier:)`를 넣어 기본 제공업체를 전환하세요."
          }
        }
      }
    },
