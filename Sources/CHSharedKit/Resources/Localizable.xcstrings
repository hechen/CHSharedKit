    "Your API key is stored securely in the device Keychain.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your API key is stored securely in the device Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein API-Schlüssel wird sicher im Schlüsselbund des Geräts gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé API est conservée en toute sécurité dans le trousseau de l’appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave API è conservata in modo sicuro nel Portachiavi del dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de API é armazenada com segurança nas Chaves do dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave API se guarda de forma segura en el llavero del dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在设备钥匙串中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはデバイスのキーチェーンに安全に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 기기 키체인에 안전하게 저장됩니다."
          }
        }
      }
    },
    "Your key is stored in the Keychain and requests go directly to %@. Usage is billed to your %@ account.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key is stored in the Keychain and requests go directly to %1$@. Usage is billed to your %2$@ account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel wird im Schlüsselbund gespeichert. Anfragen gehen direkt an %1$@, und die Nutzung wird über dein %2$@-Konto abgerechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé est conservée dans le trousseau et les requêtes sont envoyées directement à %1$@. L’utilisation est facturée sur votre compte %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave è conservata nel Portachiavi e le richieste vengono inviate direttamente a %1$@. L’utilizzo viene addebitato al tuo account %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave é armazenada nas Chaves e as solicitações vão diretamente para %1$@. O uso é cobrado na sua conta de %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave se guarda en el llavero y las solicitudes van directamente a %1$@. El uso se factura a tu cuenta de %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在钥匙串中，请求直接发送到 %1$@。用量向你的 %2$@ 账户计费。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはキーチェーンに保存し、リクエストは%1$@へ直接送信します。利用料金は%2$@アカウントに請求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 키체인에 저장되며 요청은 %1$@로 직접 전송됩니다. 사용 요금은 %2$@ 계정에 청구됩니다."
          }
        }
      }
    },
