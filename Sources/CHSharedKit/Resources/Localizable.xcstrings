    "%@ requires a one-time purchase. Open Settings → AI Provider to unlock.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requires a one-time purchase. Open Settings → AI Provider to unlock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erfordert einen einmaligen Kauf. Öffne Einstellungen → KI-Anbieter zum Freischalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nécessite un achat unique. Ouvrez Réglages → Fournisseur d’IA pour le déverrouiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede un acquisto una tantum. Apri Impostazioni → Fornitore IA per sbloccarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exige uma compra única. Abra Ajustes → Provedor de IA para desbloquear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere una compra única. Abre Ajustes → Proveedor de IA para desbloquearlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要一次性购买。请打开设置 → AI 服务商解锁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には買い切りの購入が必要です。設定 → AIプロバイダでアンロックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 일회성 구입이 필요합니다. 설정 → AI 제공업체에서 잠금 해제하세요."
          }
        }
      }
    },
