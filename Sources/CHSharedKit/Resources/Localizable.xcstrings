    "Per-source last write, external update, and sync round-trip. Resets when the app relaunches.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-source last write, external update, and sync round-trip. Resets when the app relaunches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Schreibvorgang, externe Aktualisierung und Synchronisierung je Quelle. Wird beim Neustart der App zurückgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière écriture par source, mise à jour externe et synchronisation aller-retour. Réinitialisation lorsque l'application est relancée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima scrittura, aggiornamento esterno e ciclo di sincronizzazione per ogni origine. Si azzera al riavvio dell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última gravação, atualização externa e ciclo de sincronização de cada fonte. Reinicia quando o app é aberto novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última escritura, actualización externa y ciclo de sincronización por fuente. Se reinicia al abrir la app de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各来源的最近写入、外部更新和同步往返记录。重新启动 App 后重置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースごとの最終書き込み、外部更新、同期往復を表示します。再起動時にリセットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스별 마지막 쓰기, 외부 업데이트 및 동기화 왕복 기록입니다. 앱을 다시 시작하면 초기화됩니다."
          }
        }
      }
    },
    "Pick a palette — it syncs across all your devices and apps.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a palette — it syncs across all your devices and apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Palette – sie synchronisiert sich auf allen deinen Geräten und Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une palette — elle se synchronise sur tous vos appareils et applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una palette: verrà sincronizzata su tutti i tuoi dispositivi e app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma paleta. Ela é sincronizada entre todos os seus dispositivos e apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una paleta: se sincroniza en todos tus dispositivos y apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择配色，自动同步到你的所有设备和 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配色を選ぶと、すべてのデバイスとアプリに同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상을 선택하면 모든 기기와 앱에 동기화됩니다."
          }
        }
      }
    },
    "Prices are per 1M tokens. Vision requests use additional tokens for image processing. Costs are estimates and may differ from your actual bill.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are per 1M tokens. Vision requests use additional tokens for image processing. Costs are estimates and may differ from your actual bill."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preise gelten pro 1 Mio. Token. Bildanfragen benötigen zusätzliche Token zur Bildverarbeitung. Die Kosten sind Schätzungen und können von deiner tatsächlichen Rechnung abweichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix sont indiqués par million de jetons. Les requêtes visuelles utilisent des jetons supplémentaires pour traiter les images. Les coûts sont estimatifs et peuvent différer de la facture réelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi sono per 1 milione di token. Le richieste visive usano token aggiuntivi per elaborare le immagini. I costi sono stime e possono differire dall’importo effettivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços são por 1 milhão de tokens. Solicitações de visão usam tokens adicionais para processar imagens. Os custos são estimativas e podem diferir da cobrança real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precios por millón de tokens. Las solicitudes de visión usan tokens adicionales para imágenes. Los costes son estimados y pueden diferir de la factura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格按每百万令牌计。视觉请求会为图像处理额外使用令牌。费用为估算值，可能与实际账单不同。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金は100万トークン単位です。画像処理では追加トークンを使います。費用は概算で、実際の請求とは異なる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격은 100만 토큰 기준입니다. 비전 요청은 이미지 처리에 추가 토큰을 사용합니다. 비용은 추정치이며 실제 청구액과 다를 수 있습니다."
          }
        }
      }
    },
