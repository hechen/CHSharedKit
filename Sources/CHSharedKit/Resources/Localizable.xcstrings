            "value": "バックアップはローカルに保存されます。デバイス間同期にはiCloud Driveを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 로컬에 저장됩니다. 기기 간 동기화하려면 iCloud Drive를 켜세요."
          }
        }
      }
    },
    "Backups are saved to iCloud Drive and sync across all your devices.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are saved to iCloud Drive and sync across all your devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups werden in iCloud Drive gespeichert und auf allen deinen Geräten synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont enregistrées dans iCloud Drive et synchronisées sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup sono salvati su iCloud Drive e sincronizzati su tutti i tuoi dispositivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups são salvos no iCloud Drive e sincronizados em todos os seus dispositivos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias se guardan en iCloud Drive y se sincronizan en todos tus dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份保存在 iCloud 云盘，并同步到你的所有设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップはiCloud Driveに保存され、すべてのデバイスに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 iCloud Drive에 저장되어 모든 기기에 동기화됩니다."
          }
        }
      }
    },
    "Backups are stored in iCloud Drive → %@ → Backups when iCloud is available, otherwise on this device only.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are stored in iCloud Drive → %@ → Backups when iCloud is available, otherwise on this device only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups werden unter iCloud Drive → %@ → Backups gespeichert, wenn iCloud verfügbar ist, sonst nur auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont stockées dans iCloud Drive → %@ → Backups si iCloud est disponible, sinon uniquement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup sono salvati in iCloud Drive → %@ → Backups quando iCloud è disponibile, altrimenti solo su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups são armazenados no iCloud Drive → %@ → Backups quando o iCloud está disponível. Caso contrário, ficam apenas neste dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias se guardan en iCloud Drive → %@ → Backups si iCloud está disponible; si no, solo en este dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 可用时，备份保存在 iCloud 云盘 → %@ → Backups，否则仅保存在此设备。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudが使える場合はiCloud Drive → %@ → Backupsに、それ以外はこのデバイスのみに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 사용할 수 있으면 iCloud Drive → %@ → Backups에, 그렇지 않으면 이 기기에만 백업을 저장합니다."
          }
        }
      }
    },
    "Backups are stored on this device. Enable iCloud Drive in Settings to sync them across your devices.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
